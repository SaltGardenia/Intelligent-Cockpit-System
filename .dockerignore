# Python编译文件
__pycache__/
*.pyc
*.pyo
*.pyd

# 本地虚拟环境
venv/
env/
.venv/

# Docker相关文件（避免循环复制）
.dockerignore
Dockerfile
docker-compose.yml（若后续提供，也需排除）

# 本地配置/日志/缓存
*.env
*.local
logs/
*.log
.cache/
.DS_Store（Mac系统文件）

# 版本控制文件
.git/
.gitignore
.github/

# 本地测试文件
tests/（若为内部测试，可排除；若为公开测试，保留）
*.md（可选，若镜像无需文档，可排除）